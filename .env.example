# Copy to .env and adjust. Every value is optional; defaults are sensible.

# Wikipedia categories to harvest (comma separated)
WIKI_CATEGORIES=Category:Health charities in India,Category:Cancer organisations based in India,Category:Non-profit organisations based in India

# Wikidata: country QID used by the SPARQL source (Q668 = India, Q30 = USA, Q145 = UK)
WIKIDATA_COUNTRY=Q668

# ProPublica Nonprofit Explorer search terms (comma separated)
PROPUBLICA_QUERIES=cancer care,palliative care

# Limits and politeness
MAX_PER_SOURCE=50
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15
ENRICH_WORKERS=8

# Output
OUTPUT_DIR=output
EXCEL_FILENAME=leads.xlsx

# Google Sheets (only needed with --gsheet)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_NAME=Lead Generation Output
GOOGLE_SHARE_WITH=
